cabal-version: 2.4
name:          aztecs-examples
version:       0.1.0.0

source-repository head
    type:     git
    location: https://github.com/aztecs-hs/aztecs.git

executable 2D
    main-is:          src/2D.hs
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:
        base,
        aztecs >=0.17.1 && <0.18,
        aztecs-gl >=0.1 && <0.2,
        aztecs-glfw >=0.2 && <0.3

executable ecs
    main-is:          src/ECS.hs
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:
        base,
        aztecs >=0.17.1 && <0.18

executable sprite
    main-is:          src/Sprite.hs
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:
        base,
        aztecs >=0.17.1 && <0.18,
        aztecs-gl >=0.1 && <0.2,
        aztecs-glfw >=0.2 && <0.3

executable lifecycle
    main-is:          src/Lifecycle.hs
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:
        base,
        aztecs >=0.17.1 && <0.18

executable observers
    main-is:          src/Observers.hs
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:
        base,
        aztecs >=0.17.1 && <0.18

executable pong
    main-is:          src/Pong.hs
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:
        base,
        aztecs >=0.17.1 && <0.18,
        aztecs-gl >=0.1 && <0.2,
        aztecs-glfw >=0.2 && <0.3,
        mtl,
        time

executable window
    main-is:          src/Window.hs
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:
        base,
        aztecs >=0.17.1 && <0.18,
        aztecs-glfw >=0.2 && <0.3
